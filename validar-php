#!/bin/bash
# ==============================================================================
# CCDC Blue Team PHP Lab - Scorebot & Security Validator
# Usage:
#   export ipphpserver="172.16.101.90"
#   chmod +x scorebot_php_validator.sh
#   ./scorebot_php_validator.sh           # Single evaluation run
#   ./scorebot_php_validator.sh --loop    # Continuous monitoring every 30s
# ==============================================================================

if [ -z "$ipphpserver" ]; then
    if [ -n "$1" ] && [ "$1" != "--loop" ]; then
        ipphpserver="$1"
    else
        echo "[!] Error: Please set the \$ipphpserver environment variable first."
        echo "    Example: export ipphpserver=\"172.16.101.90\" && ./scorebot_php_validator.sh"
        exit 1
    fi
fi

LOOP_MODE=false
if [ "$1" == "--loop" ] || [ "$2" == "--loop" ]; then
    LOOP_MODE=true
fi

# ANSI Colors
GREEN="\033[1;32m"
RED="\033[1;31m"
YELLOW="\033[1;33m"
CYAN="\033[1;36m"
BOLD="\033[1m"
RESET="\033[0m"

TIMEOUT=5
TMP_TEST_DIR="/tmp/scorebot_ccdc_$$"
mkdir -p "$TMP_TEST_DIR"
trap 'rm -rf "$TMP_TEST_DIR"' EXIT

# Create a valid 1x1 GIF image to test upload.php SLA
printf '\x47\x49\x46\x38\x39\x61\x01\x00\x01\x00\x80\x00\x00\xff\xff\xff\x00\x00\x00\x2c\x00\x00\x00\x00\x01\x00\x01\x00\x00\x02\x02\x44\x01\x00\x3b' > "$TMP_TEST_DIR/valid_avatar.gif"

# Create a harmless self-deleting PHP probe to test RCE in /uploads/
PAYLOAD_NAME="scorebot_probe_$$.php"
cat << 'EOF' > "$TMP_TEST_DIR/$PAYLOAD_NAME"
<?php
$w = 0;
foreach (glob("/var/www/html/*.php") as $f) {
    if (is_writable($f)) { $w++; }
}
echo "VULN_RCE_404|WRITABLE_PHP=" . $w;
@unlink(__FILE__);
?>
EOF

evaluate_lab() {
    local score=0
    local max_score=100
    local check_date
    check_date=$(date "+%Y-%m-%d %H:%M:%S")
    local remote_777_count="UNKNOWN"
    local backdoor_residual=false

    clear
    echo -e "${CYAN}==============================================================================${RESET}"
    echo -e "${BOLD}          CCDC SCOREBOARD - PHP WEB SERVER (${ipphpserver})${RESET}"
    echo -e "${CYAN}==============================================================================${RESET}"
    echo -e " Check timestamp: ${check_date}"
    echo -e " CCDC Rule: Points are only awarded when SLA is UP and the vulnerability is PATCHED.\n"
    printf " %-28s | %-14s | %-18s | %-8s\n" "MODULE / CHALLENGE" "SLA STATUS" "SECURITY STATUS" "SCORE"
    echo -e "------------------------------------------------------------------------------"

    # --------------------------------------------------------------------------
    # 1. Main Portal (ccdc-lab.php) - 15 pts (Requires SLA 200 + Not Defaced + No 777)
    # --------------------------------------------------------------------------
    local http_ccdc
    http_ccdc=$(curl -s -o "$TMP_TEST_DIR/ccdc_out.html" -w "%{http_code}" --max-time "$TIMEOUT" "http://$ipphpserver/ccdc-lab.php")

    # Remotely audit how many .php files still have 777 permissions if ping_tool is still vulnerable
    local probe_777
    probe_777=$(curl -s --max-time "$TIMEOUT" -X POST "http://$ipphpserver/ping_tool.php" \
        -d "ip=127.0.0.1; find /var/www/html -maxdepth 1 -name '*.php' -perm -0002 2>/dev/null | wc -l | awk '{print \"REM777:\"\$1}'" 2>/dev/null)
    if echo "$probe_777" | grep -q "REM777:"; then
        remote_777_count=$(echo "$probe_777" | grep -o "REM777:[0-9]*" | cut -d: -f2 | head -n1)
    fi

    if [ "$http_ccdc" == "200" ]; then
        if grep -qiE "(Archivo modificado|Modificado por www-data|Modified by www-data|chmod 777)" "$TMP_TEST_DIR/ccdc_out.html"; then
            printf " %-28s | ${GREEN}%-14s${RESET} | ${RED}%-18s${RESET} | %-8s\n" "1. Portal ccdc-lab.php" "ONLINE (200)" "DEFACED (777)" "0 / 15"
        elif [ "$remote_777_count" != "UNKNOWN" ] && [ "${remote_777_count:-0}" -gt 0 ]; then
            printf " %-28s | ${GREEN}%-14s${RESET} | ${RED}%-18s${RESET} | %-8s\n" "1. Portal ccdc-lab.php" "ONLINE (200)" "INSECURE (777)" "0 / 15"
        else
            printf " %-28s | ${GREEN}%-14s${RESET} | ${GREEN}%-18s${RESET} | %-8s\n" "1. Portal ccdc-lab.php" "ONLINE (200)" "INTACT & SECURE" "15 / 15"
            score=$((score + 15))
        fi
    else
        printf " %-28s | ${RED}%-14s${RESET} | ${RED}%-18s${RESET} | %-8s\n" "1. Portal ccdc-lab.php" "DOWN ($http_ccdc)" "SLA FAILED" "0 / 15"
    fi

    # --------------------------------------------------------------------------
    # 2. Network Ping Tool (ping_tool.php) - 25 pts
    # --------------------------------------------------------------------------
    local ping_sla_out
    ping_sla_out=$(curl -s --max-time "$TIMEOUT" -X POST "http://$ipphpserver/ping_tool.php" -d "ip=127.0.0.1")
    if echo "$ping_sla_out" | grep -qiE "(bytes from|packets transmitted|ttl=)"; then
        local ping_atk_out
        ping_atk_out=$(curl -s --max-time "$TIMEOUT" -X POST "http://$ipphpserver/ping_tool.php" -d "ip=127.0.0.1; id")
        if echo "$ping_atk_out" | grep -q "uid="; then
            printf " %-28s | ${GREEN}%-14s${RESET} | ${RED}%-18s${RESET} | %-8s\n" "2. Ping Tool (Cmd Inject)" "SLA OK" "VULNERABLE (RCE)" "0 / 25"
        else
            printf " %-28s | ${GREEN}%-14s${RESET} | ${GREEN}%-18s${RESET} | %-8s\n" "2. Ping Tool (Cmd Inject)" "SLA OK" "PATCHED" "25 / 25"
            score=$((score + 25))
        fi
    else
        printf " %-28s | ${RED}%-14s${RESET} | ${YELLOW}%-18s${RESET} | %-8s\n" "2. Ping Tool (Cmd Inject)" "SLA FAIL" "NOT EVALUATED" "0 / 25"
    fi

    # --------------------------------------------------------------------------
    # 3. Report Viewer (visor.php) - 20 pts
    # --------------------------------------------------------------------------
    local visor_sla_out
    visor_sla_out=$(curl -s --max-time "$TIMEOUT" "http://$ipphpserver/visor.php?archivo=diario.txt")
    if echo "$visor_sla_out" | grep -qiE "(Reporte|Report|CCDC)"; then
        local visor_atk_out
        visor_atk_out=$(curl -s --max-time "$TIMEOUT" "http://$ipphpserver/visor.php?archivo=../../../../etc/passwd")
        if echo "$visor_atk_out" | grep -q "root:x:0:0"; then
            printf " %-28s | ${GREEN}%-14s${RESET} | ${RED}%-18s${RESET} | %-8s\n" "3. Log Viewer (LFI/Path)" "SLA OK" "VULNERABLE (LFI)" "0 / 20"
        else
            printf " %-28s | ${GREEN}%-14s${RESET} | ${GREEN}%-18s${RESET} | %-8s\n" "3. Log Viewer (LFI/Path)" "SLA OK" "PATCHED" "20 / 20"
            score=$((score + 20))
        fi
    else
        printf " %-28s | ${RED}%-14s${RESET} | ${YELLOW}%-18s${RESET} | %-8s\n" "3. Log Viewer (LFI/Path)" "SLA FAIL" "NOT EVALUATED" "0 / 20"
    fi

    # --------------------------------------------------------------------------
    # 4. File Downloads (download.php) - 15 pts
    # --------------------------------------------------------------------------
    local dl_sla_out
    local dl_code
    dl_code=$(curl -s -o "$TMP_TEST_DIR/dl_out.txt" -w "%{http_code}" --max-time "$TIMEOUT" "http://$ipphpserver/download.php?file=diario.txt")
    dl_sla_out=$(cat "$TMP_TEST_DIR/dl_out.txt" 2>/dev/null)
    if [ "$dl_code" == "200" ] && ! echo "$dl_sla_out" | grep -qi "File not found"; then
        local dl_atk_out
        dl_atk_out=$(curl -s --max-time "$TIMEOUT" "http://$ipphpserver/download.php?file=../../../../etc/passwd")
        if echo "$dl_atk_out" | grep -q "root:x:0:0"; then
            printf " %-28s | ${GREEN}%-14s${RESET} | ${RED}%-18s${RESET} | %-8s\n" "4. Downloads (download.php)" "SLA OK" "VULNERABLE (LFI)" "0 / 15"
        else
            printf " %-28s | ${GREEN}%-14s${RESET} | ${GREEN}%-18s${RESET} | %-8s\n" "4. Downloads (download.php)" "SLA OK" "PATCHED" "15 / 15"
            score=$((score + 15))
        fi
    else
        printf " %-28s | ${RED}%-14s${RESET} | ${YELLOW}%-18s${RESET} | %-8s\n" "4. Downloads (download.php)" "SLA FAIL" "NOT EVALUATED" "0 / 15"
    fi

    # --------------------------------------------------------------------------
    # 5. Avatar Upload (upload.php + /uploads/) - 25 pts
    # --------------------------------------------------------------------------
    local up_sla_out
    up_sla_out=$(curl -s --max-time "$TIMEOUT" -F "avatar=@$TMP_TEST_DIR/valid_avatar.gif;type=image/gif" "http://$ipphpserver/upload.php")
    if echo "$up_sla_out" | grep -qiE "(subido|subida|correctamente|exitosamente|uploaded|successfully|saved)"; then
        # Attempt to upload and execute PHP probe
        curl -s --max-time "$TIMEOUT" -F "avatar=@$TMP_TEST_DIR/$PAYLOAD_NAME" "http://$ipphpserver/upload.php" > /dev/null
        local rce_check
        rce_check=$(curl -s --max-time "$TIMEOUT" "http://$ipphpserver/uploads/$PAYLOAD_NAME")

        # Check if manual test backdoor payload.php is still active
        local old_payload_check
        old_payload_check=$(curl -s --max-time "$TIMEOUT" "http://$ipphpserver/uploads/payload.php")
        if echo "$old_payload_check" | grep -q "uid="; then
            backdoor_residual=true
        fi

        # Extract writable PHP count if probe executed
        if echo "$rce_check" | grep -q "WRITABLE_PHP="; then
            remote_777_count=$(echo "$rce_check" | grep -o "WRITABLE_PHP=[0-9]*" | cut -d= -f2)
        fi

        if echo "$rce_check" | grep -q "VULN_RCE_404"; then
            printf " %-28s | ${GREEN}%-14s${RESET} | ${RED}%-18s${RESET} | %-8s\n" "5. Avatar Upload (/uploads)" "SLA OK" "VULNERABLE (Shell)" "0 / 25"
        elif [ "$backdoor_residual" = true ]; then
            printf " %-28s | ${GREEN}%-14s${RESET} | ${YELLOW}%-18s${RESET} | %-8s\n" "5. Avatar Upload (/uploads)" "SLA OK" "ACTIVE BACKDOOR" "0 / 25"
        else
            printf " %-28s | ${GREEN}%-14s${RESET} | ${GREEN}%-18s${RESET} | %-8s\n" "5. Avatar Upload (/uploads)" "SLA OK" "PATCHED" "25 / 25"
            score=$((score + 25))
        fi
    else
        printf " %-28s | ${RED}%-14s${RESET} | ${YELLOW}%-18s${RESET} | %-8s\n" "5. Avatar Upload (/uploads)" "SLA FAIL" "NOT EVALUATED" "0 / 25"
    fi

    echo -e "------------------------------------------------------------------------------"

    # --------------------------------------------------------------------------
    # Remote Permissions & Persistence Summary on $ipphpserver
    # --------------------------------------------------------------------------
    if [ "$remote_777_count" != "UNKNOWN" ]; then
        if [ "${remote_777_count:-0}" -gt 0 ]; then
            echo -e " ${RED}[!] File Permissions on ${ipphpserver}:${RESET} ${RED}${BOLD}${remote_777_count} .php files${RESET} have 777 permissions (writable by www-data)."
        else
            echo -e " ${GREEN}[+] File Permissions on ${ipphpserver}:${RESET} No .php files are world-writable (644 applied)."
        fi
    else
        echo -e " ${GREEN}[+] File Permissions on ${ipphpserver}:${RESET} RCE closed; www-data can no longer audit permissions remotely."
    fi

    if [ "$backdoor_residual" = true ]; then
        echo -e " ${YELLOW}[!] Persistence Alert:${RESET} Webshell ${RED}/uploads/payload.php${RESET} is still active on the server."
    fi
    echo -e "------------------------------------------------------------------------------"

    # Final score color
    local color_score="$RED"
    if [ "$score" -ge 85 ]; then
        color_score="$GREEN"
    elif [ "$score" -ge 40 ]; then
        color_score="$YELLOW"
    fi

    echo -e " ${BOLD}TOTAL TEAM SCORE:${RESET} ${color_score}${BOLD}${score} / ${max_score} POINTS${RESET}"
    echo -e "${CYAN}==============================================================================${RESET}"
}

if [ "$LOOP_MODE" = true ]; then
    while true; do
        evaluate_lab
        echo -e "\n[*] Next automatic check in 30 seconds... (Press Ctrl+C to stop)"
        sleep 30
    done
else
    evaluate_lab
fi
