<script>
function fmtIdle(s){
  if(s===null||s===undefined) return "\\u2014";
  if(s<60) return s+"s";
  var m=Math.floor(s/60), r=s%60; return m+"m "+r+"s";
}
async function api(path, body){
  var o={method:"POST",headers:{"Content-Type":"application/json"}};
  if(body) o.body=JSON.stringify(body);
  await fetch(path,o); load();
}
function addM(){
  var ip=document.getElementById("ip").value.trim();
  var name=document.getElementById("name").value.trim();
  if(!ip) return;
  api("/api/add",{ip:ip,name:name});
  document.getElementById("ip").value="";
  document.getElementById("name").value="";
}
document.getElementById("ip").addEventListener("keydown",function(e){if(e.key==="Enter")addM();});
document.getElementById("name").addEventListener("keydown",function(e){if(e.key==="Enter")addM();});
function esc(s){var d=document.createElement("div");d.textContent=s||"";return d.innerHTML;}
async function load(){
  var r=await fetch("/api/status"); var d=await r.json();
  document.getElementById("thr").textContent="clean after "+d.threshold+"s idle";
  var tb=document.getElementById("rows"); tb.innerHTML="";
  document.getElementById("empty").style.display=d.machines.length?"none":"block";
  d.machines.forEach(function(m){
    var tr=document.createElement("tr"); tr.className=m.status;
    tr.innerHTML=
      '<td class="'+m.status+'"><span class="dot"></span><span class="st">'+m.status.toUpperCase()+'</span></td>'+
      '<td>'+esc(m.ip)+'</td>'+
      '<td class="muted">'+(esc(m.name)||"\\u2014")+'</td>'+
      '<td class="muted">'+fmtIdle(m.idle)+'</td>'+
      '<td class="muted">'+m.count+'</td>'+
      '<td><button class="ghost" onclick="api(\\'/api/delete\\',{ip:\\''+m.ip+'\\'})">remove</button></td>';
    tb.appendChild(tr);
  });
}
load(); setInterval(load,3000);
</script>
</body></html>
"""


def main():
    ap = argparse.ArgumentParser(description="CCDC canary check-in monitor")
    ap.add_argument("--port", type=int, default=8081)
    ap.add_argument("--bind", default="0.0.0.0")
    ap.add_argument("--state", default=os.path.expanduser("~/.redhavi-monitor.json"),
                    help="JSON state file persisted across restarts")
    ap.add_argument("--payload", default=None,
                    help="file served at /checkin (default: trivial canary)")
    ap.add_argument("--clean-threshold", type=int, default=240,
                    help="seconds without a check-in before turning GREEN (default: 240)")
    ap.add_argument("--no-auto-discover", action="store_true",
                    help="do not add new IPs automatically when they check in")
    args = ap.parse_args()

    CONFIG["state_file"] = args.state
    CONFIG["payload_file"] = args.payload
    CONFIG["clean_threshold"] = args.clean_threshold
    CONFIG["auto_discover"] = not args.no_auto_discover
    load_state()

    httpd = ThreadingHTTPServer((args.bind, args.port), Handler)
    print("redhavi-monitor")
    print("  dashboard : http://%s:%d/" % (args.bind, args.port))
    print("  check-in  : http://%s:%d/checkin" % (args.bind, args.port))
    print("  threshold : %ds (clean after this idle)" % args.clean_threshold)
    print("  state     : %s" % args.state)
    print("  Ctrl-C to stop")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nbye")
        save_state()


if __name__ == "__main__":
    main()
