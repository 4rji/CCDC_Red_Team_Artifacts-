<header>
  <h1>&#9760; REDHAVI MONITOR</h1>
  <span class="sub" id="thr"></span>
  <div class="legend">
    <span><i class="dot" style="background:#f85149"></i>&nbsp;RED = dirty (checking in)</span>
    <span><i class="dot" style="background:#3fb950"></i>&nbsp;GREEN = clean</span>
  </div>
</header>
<div class="wrap">
  <div class="add">
