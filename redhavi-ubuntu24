#!/usr/bin/env bash
set -Eeuo pipefail

# Ubuntu 24.04 profile for the shared, hardened Ubuntu scenario implementation.
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

export REDHAVI_PROGRAM_NAME="redhavi-ubuntu24"
export REDHAVI_SCENARIO_NAME="redhavi-ubuntu24"
export REDHAVI_SCENARIO_VERSION="1"
export REDHAVI_EXPECTED_CHECKS="10"
export REDHAVI_REQUIRED_VERSION_ID="24.04"
export REDHAVI_ENABLE_CANARY="1"

# shellcheck source=redhavi
. "${SCRIPT_DIR}/redhavi"
main "$@"
